rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    
    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == 'destek@omernasuhakademi.com';
    }

    function isVerified() { 
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        isSystemAdmin() ||
        request.auth.token.firebase.sign_in_provider == 'password'
      ); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    function isAdmin() {
      return isSystemAdmin() || (
        isSignedIn() && request.auth.token.email.endsWith('@omernasuhakademi.com') && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' || 
         request.auth.token.email == 'destek@omernasuhakademi.com')
      ) || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }

    function isCoach() {
      return (
        isSignedIn() && request.auth.token.email.endsWith('@omernasuhakademi.com') &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'coach'
      ) || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'coach'
      );
    }

    function isCoachOf(studentId) {
      return isCoach() && 
             exists(/databases/$(database)/documents/users/$(studentId)) &&
             get(/databases/$(database)/documents/users/$(studentId)).data.get('coachId', '') == request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStudentOf(coachId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coachId', '') == coachId;
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.get('uid', '') == userId &&
               data.get('role', '') in ['student', 'coach', 'admin'];
      }

      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isAdmin() || isOwner(userId) || isCoachOf(userId) || (isStudentOf(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['systemBalance', 'updatedAt'])) || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasAny(['referralCount', 'referralEarnings', 'walletBalance']))) && 
                    isValidUser(incoming()) &&
                    incoming().get('role', '') == existing().get('role', '') &&
                    incoming().get('uid', '') == existing().get('uid', '');
    }

    // 2. Weekly Reports (Legacy but keep for now)
    match /weekly_reports/{reportId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner(resource.data.studentId) || isCoachOf(resource.data.studentId));
      allow write: if isAdmin() || isCoach();
    }

    // 3. Exam Results
    match /exam_results/{resultId} {
      function isValidResult(data) {
        return isValidId(data.get('studentId', '')) && 
               data.get('examName', '') is string &&
               data.get('examType', '') in ['TYT', 'AYT', 'MSÜ', 'LGS', 'YDT', 'YKS', 'BRANŞ'];
      }

      allow read: if isSignedIn() && (isOwner(resource.data.studentId) || isAdmin() || isCoachOf(resource.data.studentId));
      allow create: if isSignedIn() && (isOwner(incoming().get('studentId', '')) || isAdmin() || isCoach()) && isValidResult(incoming());
      allow update: if isSignedIn() && (isOwner(existing().get('studentId', '')) || isAdmin() || isCoachOf(existing().get('studentId', ''))) && 
                    isValidResult(incoming()) &&
                    incoming().get('studentId', '') == existing().get('studentId', '');
      allow delete: if isSignedIn() && (isOwner(resource.data.studentId) || isAdmin() || isCoachOf(resource.data.studentId));
    }

    // 3.5 Exam Analyses
    match /exam_analyses/{analysisId} {
      allow read: if isSignedIn() && (isOwner(resource.data.get('studentId', '')) || isAdmin() || isCoachOf(resource.data.get('studentId', '')));
      allow create: if isVerified() && (isOwner(incoming().get('studentId', '')) || isAdmin() || isCoach());
      allow update: if isVerified() && (isOwner(existing().get('studentId', '')) || isAdmin() || isCoachOf(existing().get('studentId', ''))) && 
                    incoming().get('studentId', '') == existing().get('studentId', '') &&
                    incoming().get('examId', '') == existing().get('examId', '');
      allow delete: if isAdmin();
    }

    // 4. Book Tracking
    match /book_tracking/{trackId} {
      function isValidTrack(data) {
        return isValidId(data.get('studentId', '')) && 
               data.get('subject', '') is string && 
               data.get('bookName', '') is string;
      }

      allow read: if isSignedIn() && (isOwner(resource.data.studentId) || isAdmin() || isCoachOf(resource.data.studentId));
      allow create: if isSignedIn() && (isOwner(incoming().get('studentId', '')) || isAdmin() || isCoach()) && isValidTrack(incoming());
      allow update: if isSignedIn() && (isOwner(existing().get('studentId', '')) || isAdmin() || isCoachOf(existing().get('studentId', ''))) && 
                    isValidTrack(incoming()) &&
                    incoming().get('studentId', '') == existing().get('studentId', '');
      allow delete: if isSignedIn() && (isOwner(resource.data.studentId) || isAdmin() || isCoachOf(resource.data.studentId));
    }

    // 5. Weekly Programs
    match /weekly_programs/{programId} {
      function isValidProgram(data) {
        return isValidId(data.get('studentId', '')) && 
               (data.get('coachId', '') == '' || isValidId(data.get('coachId', '')));
      }

      allow read: if isSignedIn() && (isAdmin() || isOwner(resource.data.studentId) || isOwner(resource.data.coachId) || isCoachOf(resource.data.studentId));
      allow create: if isSignedIn() && (isAdmin() || isCoach() || isOwner(incoming().studentId)) && isValidProgram(incoming());
      allow update: if isSignedIn() && (isAdmin() || isCoachOf(existing().studentId) || isOwner(existing().coachId) || isOwner(existing().studentId)) && 
                    isValidProgram(incoming()) &&
                    incoming().studentId == existing().studentId &&
                    (isAdmin() || incoming().coachId == existing().coachId);
      allow delete: if isAdmin() || isCoachOf(resource.data.studentId);
    }

    // 6. Appointments
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 7. Coach Schedules
    match /coach_schedules/{coachId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(coachId);
    }

    // 8. Services
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 9. Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 10. Global Books
    match /global_books/{bookId} {
      function isValidGlobalBook(data) {
        return data.get('name', '') is string &&
               data.get('subject', '') is string &&
               data.get('type', '') is string;
      }
      
      allow read: if isSignedIn();
      allow write: if isAdmin() || isCoach();
    }
    // 11. Daily Programs
    match /daily_programs/{programId} {
      function isValidDaily(data) {
        return isValidId(data.get('studentId', '')) && 
               data.get('date', '') is string;
      }

      allow read: if isSignedIn() && (isAdmin() || isOwner(resource.data.studentId) || isCoachOf(resource.data.studentId));
      allow create: if isSignedIn() && (isAdmin() || isCoach() || isOwner(incoming().studentId)) && isValidDaily(incoming());
      allow update: if isSignedIn() && (isAdmin() || isCoachOf(existing().studentId) || isOwner(existing().studentId)) && 
                    isValidDaily(incoming()) &&
                    incoming().studentId == existing().studentId;
      allow delete: if isAdmin() || isCoachOf(resource.data.studentId);
    }

    // 11.5 Coach Chats
    match /coach_chats/{coachId} {
      allow read, write: if isSignedIn() && (isAdmin() || request.auth.uid == coachId);
    }

    // 12. Routines
    match /routines/{studentId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner(studentId) || isCoachOf(studentId));
      allow write: if isSignedIn() && (isAdmin() || isCoach() || isOwner(studentId));
    }

    // 13. Monthly Goals
    match /monthly_goals/{goalId} {
      function isValidGoal(data) {
        return isValidId(data.get('studentId', '')) && 
               data.get('month', '') is string;
      }

      allow read: if isSignedIn() && (resource == null || isOwner(resource.data.get('studentId', '')) || isAdmin() || isCoachOf(resource.data.get('studentId', '')));
      allow create: if isSignedIn() && (isOwner(incoming().get('studentId', '')) || isAdmin() || isCoachOf(incoming().get('studentId', ''))) && isValidGoal(incoming());
      allow update: if isSignedIn() && (isOwner(existing().get('studentId', '')) || isAdmin() || isCoachOf(existing().get('studentId', ''))) && 
                    isValidGoal(incoming()) &&
                    incoming().get('studentId', '') == existing().get('studentId', '') &&
                    incoming().get('month', '') == existing().get('month', '');
      allow delete: if isAdmin() || isCoachOf(resource.data.get('studentId', ''));
    }

    // 14. Wallet Transactions
    match /wallet_transactions/{transactionId} {
      function isValidTransaction(data) {
        return (isValidId(data.get('studentId', '')) || isValidId(data.get('coachId', ''))) &&
               data.get('amount', 0) is number &&
               data.get('type', '') in ['DEPOSIT', 'WITHDRAWAL', 'SYSTEM_DEPOSIT'];
      }

      allow read: if isSignedIn() && (resource == null || isOwner(resource.data.studentId) || isAdmin() || isCoachOf(resource.data.studentId) || resource.data.coachId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || (isCoachOf(incoming().studentId) && incoming().type == 'DEPOSIT') || (isOwner(incoming().studentId) && incoming().type == 'WITHDRAWAL') || (request.auth.uid == incoming().coachId && incoming().type == 'WITHDRAWAL')) && isValidTransaction(incoming());
      // Withdrawal is limited to admin for now? Or automatic? 
      // For now, let's allow coach to deposit.
    }

    // 15. User Analyses
    match /user_analyses/{analysisId} {
      function isValidAnalysis(data) {
        return isValidId(data.get('userId', '')) &&
               data.get('analysisType', '') is string;
      }
      allow read: if isSignedIn() && (resource == null || isOwner(resource.data.userId) || isAdmin() || isCoachOf(resource.data.userId));
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidAnalysis(incoming());
      allow update: if isSignedIn() && isOwner(resource.data.userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['aiInsight'])
      );
      allow delete: if isAdmin();
    }

    // 16. Chocolate Bank Status
    match /chocolate_bank_status/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isCoachOf(userId));
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isCoachOf(userId));
    }

    // 17. Chocolate Bank Transactions
    match /chocolate_bank_transactions/{transactionId} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isAdmin() || 
        (resource != null && isCoachOf(resource.data.userId))
      );
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid || 
        isAdmin() || 
        isCoachOf(incoming().userId)
      );
      allow update, delete: if isAdmin();
    }

    // 18. Programs
    match /programs/{programId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['enrolledCount']));
    }

    // 19. Program Enrollments
    match /program_enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (
        resource == null || 
        isOwner(resource.data.studentId) || 
        isAdmin() || 
        isCoachOf(resource.data.studentId)
      );
      allow create: if isSignedIn() && (
        isOwner(incoming().studentId) || 
        isAdmin() || 
        isCoachOf(incoming().studentId)
      );
      allow update: if isSignedIn() && (
        isOwner(resource.data.studentId) || 
        isAdmin() || 
        isCoachOf(resource.data.studentId)
      );
      allow delete: if isAdmin();
    }

    // 20. Events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['tickets']));
    }
    match /event_rsvps/{rsvpId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(incoming().studentId);
      allow delete: if isAdmin();
    }
    match /ticket_orders/{orderId} {
      allow read: if isSignedIn() && (isOwner(resource.data.studentId) || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().studentId);
      allow delete: if isAdmin();
    }
    // 21. Products
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 22. Purchases
    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && (isOwner(resource.data.studentId) || isAdmin() || isCoachOf(resource.data.studentId));
      allow create: if isSignedIn() && (isOwner(incoming().studentId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 23. Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 24. Referral History
    match /referral_history/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // 25. Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || isOwner(resource.data.userId) || isAdmin() || isCoachOf(resource.data.userId));
      allow create: if isSignedIn() && (isOwner(incoming().userId) || isAdmin() || isCoach());
      allow update: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }
  }
}

