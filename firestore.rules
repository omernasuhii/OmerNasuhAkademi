rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Auth Helpers
    function isSignedIn() { return request.auth != null; }
    
    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'destek@omernasuhakademi.com' ||
        request.auth.token.get('email', '') == 'omernasuhagir2@gmail.com' ||
        request.auth.token.get('email', '') == 'omernasuhagir@gmail.com'
      );
    }

    function isVerified() { 
      return isSignedIn() && (
        request.auth.token.get('email_verified', false) == true || 
        isSystemAdmin() ||
        request.auth.token.firebase.sign_in_provider == 'password'
      ); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    function isAdmin() {
      return isSystemAdmin() || (
        isSignedIn() && request.auth.token.get('email', '').endsWith('@omernasuhakademi.com') && 
        ( (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin') || 
         request.auth.token.get('email', '') == 'destek@omernasuhakademi.com')
      ) || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'superadmin']
      );
    }

    function isCoach() {
      return (
        isSignedIn() && request.auth.token.get('email', '').endsWith('@omernasuhakademi.com') &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'coach'
      ) || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'coach'
      );
    }

    function isParent() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'parent';
    }

    function isCoachOf(studentId) {
      return isCoach() && studentId != null && studentId != '' && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentIds', []) is list && 
         studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentIds', [])) ||
        isCoach() ||
        isAdmin()
      );
    }

    function isParentOf(studentId) {
      return isSignedIn() && studentId != null && studentId != '' && (
        // Option 1: The parent's own user document contains the studentId as 'studentUid'
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentUid', '') == studentId) ||
        
        // Option 2: The parent's own user document contains the studentId as 'studentId'
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentId', '') == studentId) ||
          
        // Option 3: The parent's own user document contains the studentId inside a 'studentIds' list
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentIds', []) is list && 
         studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentIds', [])) ||
          
        // Option 4: Fallback if the user is registered as a parent or admin
        isParent() ||
        isAdmin()
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStudentOf(coachId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coachId', '') == coachId;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /inbox_messages/{messageId} {
      allow read, write: if true;
    }

    match /whatsapp_messages/{messageId} {
      allow read, write: if true;
    }

    match /whatsapp_templates/{templateId} {
      allow read, write: if true;
    }

    match /whatsapp_webhook_logs/{logId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /phone_verifications/{verificationId} {
      allow read, write: if true;
    }

    match /simulated_verifications/{verificationId} {
      allow read, write: if true;
    }

    match /verification_logs/{logId} {
      allow read, write: if true;
    }

    match /system_error_logs/{logId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() || request.auth == null;
      allow update: if isSignedIn() || request.auth == null;
      allow delete: if isAdmin() || isOwner(userId);
      
      match /ai_chat_views/{targetId} {
        allow read, write: if isSignedIn();
      }

      match /solved_questions/{qId} {
        allow read, write: if isSignedIn();
      }
    }

    // 1.5 Bolumler Collection
    match /bolumler/{bolumId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 2. Weekly Reports
    match /weekly_reports/{reportId} {
      allow read, write: if true;
    }

    match /weekly_pdf_reports/{reportId} {
      allow read, write: if true;
    }

    match /weekly_report_logs/{logId} {
      allow read, write: if true;
    }

    // 3. Exam Results
    match /exam_results/{resultId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 3.5 Exam Analyses
    match /exam_analyses/{analysisId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 4. Book Tracking
    match /book_tracking/{trackId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 5. Weekly Programs
    match /weekly_programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 5.5 AI Chat History
    match /ai_chat_history/{userId} {
      allow read, write: if isSignedIn();
    }
    match /ai_solver_state/{userId} {
      allow read, write: if isSignedIn();
    }
    match /parent_ai_chat_history/{userId} {
      allow read, write: if isSignedIn();
    }

    // 6. Appointments
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // 7. Coach Schedules
    match /coach_schedules/{coachId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 8. Services
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 9. Rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 10. Global Books & Curriculum
    match /global_books/{bookId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /curriculum/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /global_questions/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /global_academic_exams/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 11. Daily Programs
    match /daily_programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 11.5 Coach Chats
    match /coach_chats/{coachId} {
      allow read, write: if isSignedIn();
    }

    // 12. Routines
    match /routines/{studentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 12.5 Weekly Evaluations
    match /weeklyEvaluations/{evalId} {
      allow read, write: if true;
    }

    // 13. Monthly Goals
    match /monthly_goals/{goalId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 14. Wallet Transactions
    match /wallet_transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    // 15. User Analyses
    match /user_analyses/{analysisId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 16. Chocolate Bank Status
    match /chocolate_bank_status/{userId} {
      allow read, write: if isSignedIn();
    }

    // 17. Chocolate Bank Transactions
    match /chocolate_bank_transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    // 18. Programs
    match /programs/{programId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 19. Program Enrollments
    match /program_enrollments/{enrollmentId} {
      allow read, write: if isSignedIn();
    }

    // 20. Events
    match /event_categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /event_rsvps/{rsvpId} {
      allow read, write: if true;
    }
    match /ticket_orders/{orderId} {
      allow read, write: if true;
    }

    // 21. Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 22. Purchases
    match /purchases/{purchaseId} {
      allow read, write: if isSignedIn();
    }

    // 23. Coupons & Settings
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /subscription_history/{historyId} {
      allow read, write: if isSignedIn();
    }

    match /carts/{userId} {
      allow read, write: if true;
    }

    match /referral_history/{historyId} {
      allow read, write: if isSignedIn();
    }

    // 25. Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 26. User Sessions & Study Sessions
    match /study_sessions/{sessionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /user_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 27. CABA Tests
    match /caba_tests/{testId} {
      allow read, write: if true;
    }

    // 28. Chats
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // 29. User Tokens
    match /userTokens/{userId} {
      allow read, write: if isSignedIn();
    }

    // 30. Academic Calendar
    match /academic_calendar/{calendarId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 31. Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 32. Social Media AI Chats & Saved Items
    match /social_media_ai_chats/{chatId} {
      allow read, write: if true;
    }

    match /social_media_saved_items/{itemId} {
      allow read, write: if true;
    }
  }
}
